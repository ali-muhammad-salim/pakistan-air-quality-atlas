# Environment variables for Vercel deployment with Turso (LibSQL)
# Get these from your Turso dashboard (https://turso.tech) or running: turso db show air-quality-db --url
TURSO_DATABASE_URL="libsql://air-quality-db-[your-username].turso.io"

# Get this by running: turso db tokens create air-quality-db
TURSO_AUTH_TOKEN="your_turso_auth_token_here"
